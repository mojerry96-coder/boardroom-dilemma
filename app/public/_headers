# Cache rules for hosts that read a _headers file (Netlify, Cloudflare Pages). Other hosts: apply the same
# rules in their config. Hashed app files never change; media can be re-recorded, so it revalidates weekly.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/scenes/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/evidence/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/props/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/voice/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/films/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
